{
  "name": "agentnexus-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:map": "node --test verification/check-map.test.mjs && node verification/check-map.mjs",
    "test:e2e": "tsc --noEmit -p e2e/tsconfig.json && playwright test",
    "verify": "node verification/run.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "^30.1.3",
    "typescript": "~7.0.2",
    "vite": "8.3.5",
    "vitest": "^5.1.0"
  }
}
